{
  "manifest_version": 3,
  "name": "Kindle Highlights",
  "version": "2.0.0",
  "description": "Sincroniza tus subrayados y notas de Kindle desde read.amazon.com/notebook y expórtalos a Word o JSON.",
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": [
    "https://read.amazon.com/*",
    "https://read.amazon.co.uk/*",
    "https://read.amazon.de/*",
    "https://read.amazon.fr/*",
    "https://read.amazon.es/*",
    "https://read.amazon.it/*",
    "https://read.amazon.ca/*",
    "https://read.amazon.com.au/*",
    "https://read.amazon.in/*",
    "https://read.amazon.co.jp/*",
    "https://read.amazon.com.br/*",
    "https://read.amazon.com.mx/*",
    "https://read.amazon.nl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Kindle Highlights",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://read.amazon.com/*notebook*",
        "https://read.amazon.co.uk/*notebook*",
        "https://read.amazon.de/*notebook*",
        "https://read.amazon.fr/*notebook*",
        "https://read.amazon.es/*notebook*",
        "https://read.amazon.it/*notebook*",
        "https://read.amazon.ca/*notebook*",
        "https://read.amazon.com.au/*notebook*",
        "https://read.amazon.in/*notebook*",
        "https://read.amazon.co.jp/*notebook*",
        "https://read.amazon.com.br/*notebook*",
        "https://read.amazon.com.mx/*notebook*",
        "https://read.amazon.nl/*notebook*"
      ],
      "js": [
        "shared/storage.js",
        "content/selectors.js",
        "content/scraper.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
